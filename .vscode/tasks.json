				"command": "powershell -NoProfile -Command \"try { (Invoke-WebRequest -UseBasicParsing 'https://a.basemaps.cartocdn.com/rastertiles/voyager/12/2961/1897.png').StatusCode } catch { Write-Output $_.Exception.Message; exit 1 }\""
			},
			"isBackground": false,
			"problemMatcher": []
